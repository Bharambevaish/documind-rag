# Copy this file to `.env` and fill in your values:
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (Mac/Linux)
# The real .env file is git-ignored, so your key is never pushed to GitHub.

# Which LLM to use: "groq" (cloud, free tier) or "ollama" (runs locally)
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys (only needed when LLM_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# Model name. Leave empty to use the default for the chosen provider:
#   groq   -> llama-3.1-8b-instant
#   ollama -> llama3
MODEL_NAME=

# How many document chunks to retrieve for each question
TOP_K=4

# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
